---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="sticky-footer">
    <Header />
    <main class="flex-1">
      <div class="main-container max-w-720">
        <div class="content-title">
          <h2>ABOUT</h2>
          <h3>事業者情報</h3>
        </div>
        <div class="content company-info">
          <dl>
            <dt>屋号：</dt>
            <dd>電子工房たそかれ（Atelier TASOKARE）</dd>
            <dt>設立：</dt>
            <dd>2026年10月2日（旧屋号「TASOKARE」より変更）</dd>
            <dt>所在地：</dt>
            <dd>〒101-0024 東京都千代田区神田和泉町1番地6-16 ヤマトビル405</dd>
            <dt>代表：</dt>
            <dd>中村 徹</dd>
            <dt>事業内容：</dt>
            <dd>
              <p>スマートフォン向けアプリケーションの企画・開発・販売</p>
              <p>スマートフォン向けゲームの企画・開発・販売</p>
              <p>PC向けソフトウェアの企画・開発・販売</p>
              <p>PC向けゲームの企画・開発・販売</p>
            </dd>
            <dt>お問合わせ：</dt>
            <dd>
              <p>contact@atelier-tasokare.com</p>
            </dd>
          </dl>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
