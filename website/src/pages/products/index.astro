---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="sticky-footer">
    <Header />
    <main class="flex-1">
      <div class="main-container max-w-720">
        <div class="content-title">
          <h2>PRODUCTS</h2>
          <h3>製品情報</h3>
        </div>
        <div class="content product-card">
          <div class="flex-pc">
            <img src="../img/app.svg" alt="eyecatch" class="eyecatch">
            <div class="product-info">
              <h2>たそかれホーム</h2>
              <p class="product-platform">Android</p>
              <p class="product-description">ホーム画面を見やすくシンプルにするアプリ。</p>
            </div>
          </div>
          <hr />
          <div class="flexbox justify-between items-center">
            <p class="product-status">開発中</p>
            <!-- <div class="btn-more-container">
              <a href="/products/tasokarehome/" class="btn-more flexbox justify-center items-center">
                <span>詳細をみる</span>
                <img src="/img/double_arrow.svg" alt="矢印" />
              </a>
            </div> -->
          </div>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
